{
  "name": "claude-code-relay",
  "version": "1.0.0",
  "description": "Relay WhatsApp messages to Claude Code CLI",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
